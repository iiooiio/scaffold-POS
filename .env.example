# URL base de tu sitio WooCommerce (sin slash final)
WC_BASE_URL=https://tu-sitio.com

# Claves REST API de WooCommerce (WooCommerce > Ajustes > Avanzado > REST API)
WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Identificador único de esta caja (usado para folios locales y trazabilidad)
REGISTER_ID=CAJA1

# Nombre de la impresora térmica USB (ver README para cómo obtenerlo)
PRINTER_INTERFACE=printer:auto

# Cada cuántos ms intenta sincronizar catálogo y cola de órdenes
SYNC_INTERVAL_MS=30000
